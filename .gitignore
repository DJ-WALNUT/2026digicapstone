# ============================================================
# 대체품 (2026 디지털스토리텔링캡스톤디자인) .gitignore
# ============================================================

# ------------------------------------------------------------
# [올리면 안 되는 파일] 개인 환경 / 로컬 설정
# ------------------------------------------------------------
# MCP 설정: 개인 PC 절대경로(uv.exe, D:\...)가 들어 있어 팀원 환경에서 동작 안 함
.mcp.json
# Claude Code 개인 설정
.claude/settings.local.json
# 환경변수 / API 키 (Seedance, Meshy, Tripo 등 키를 쓰게 될 경우 대비)
.env
.env.*
!.env.example
*.key
secrets/

# ------------------------------------------------------------
# [올릴 필요 없는 파일] 외부 도구 (각자 설치)
# ------------------------------------------------------------
# Blender MCP 서버: 외부 오픈소스, README의 설치 방법으로 각자 받으면 됨
mcp-for-blender-main/
mcp-for-blender-main.zip

# Python 가상환경 / 캐시 (혹시 다른 위치에 생길 경우)
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/

# ------------------------------------------------------------
# [올릴 필요 없는 파일] 압축 백업 / 중복본
# ------------------------------------------------------------
# 프로젝트 전체 스냅샷 zip, 팀원배포 폴더를 그대로 압축한 zip 등
# (원본 폴더가 이미 레포에 있으므로 중복 + 용량 큼)
*.zip
*.7z
*.rar

# ------------------------------------------------------------
# [올릴 필요 없는 파일] Blender 자동 생성 파일
# ------------------------------------------------------------
# 저장 시 자동으로 생기는 백업본 (.blend1, .blend2 ...)
*.blend[0-9]
*.blend[0-9][0-9]
# 자동저장 / 크래시 복구 파일
*.blend@
quit.blend
*_autosave.blend

# ------------------------------------------------------------
# [올릴 필요 없는 파일] 대용량 영상 렌더 / 중간 산출물
# ------------------------------------------------------------
# 영상 파일은 GitHub 100MB 제한에 걸리기 쉬움 → 드라이브로 공유
# (꼭 올려야 하는 최종본이 생기면 Git LFS 사용 권장)
*.mp4
*.mov
*.avi
*.mkv
*.webm
*.wav
*.exr
# Seedance 등 생성 중간 결과물 임시 폴더
tmp/
temp/
cache/

# ------------------------------------------------------------
# [올릴 필요 없는 파일] OS / 에디터 / Office 임시 파일
# ------------------------------------------------------------
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
# macOS (팀원이 맥 쓰는 경우)
.DS_Store
._*
# Word/Excel/PowerPoint 열려 있을 때 생기는 잠금 파일
~$*
# 에디터
.vscode/
.idea/
*.swp
*~

# TTS 비교 샘플 (로컬에서 듣기)
03_대본/tts_비교/
03_대본/tts_EL/

# ------------------------------------------------------------
# [올릴 필요 없는 파일] 취소된 옛 작업 묶음 (로컬 보관용)
# ------------------------------------------------------------
# 1006622 커밋에서 정리됨. 필요하면 git 이력에서 복구 가능
/02_팀원배포/재분배_팀원1/
/02_팀원배포/재분배_팀원2/
/02_팀원배포/컷작업1차_팀원1/
/02_팀원배포/컷작업1차_팀원2/
/05_본제작/영상생성_묶음/_쓰지않음_*/
